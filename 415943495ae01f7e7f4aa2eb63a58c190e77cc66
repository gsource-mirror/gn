      "writtenOn": "2026-04-21T10:17:00Z",
      "side": 1,
      "message": "BUG: Use `SubstitutionWriter::ApplyPatternToCompilerAsOutputFile` instead of `ApplyPatternToSourceAsOutputFile`. \n\n`ApplyPatternToSourceAsOutputFile` only supports source-level substitutions. If a user uses target-level substitutions like `{{target_out_dir}}` or `{{target_output_name}}` in `additional_outputs`, they will expand to empty strings. The \u0027compiler\u0027 version supports both target and source substitutions, which is expected for tool outputs.",
      "range": {
        "startLine": 443,
        "startChar": 0,
        "endLine": 443,
        "endChar": 0
      },
      "revId": "415943495ae01f7e7f4aa2eb63a58c190e77cc66",
      "serverId": "c360c8e5-7aa8-3905-a7a0-810934766dac"
    },
