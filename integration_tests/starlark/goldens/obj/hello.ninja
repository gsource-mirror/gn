defines =
include_dirs =
cflags = -fPIC -pthread
target_out_dir = obj
target_output_name = hello

executable_sub = hello
build obj/hello.hello.o: cxx ../../integration_tests/starlark/hello.cc
  source_file_part = hello.cc
  source_name_part = hello

build hello: link obj/hello.hello.o ./libhello_shared.so obj/libhello_static.a
  ldflags = -Wl,-rpath=\$$ORIGIN/ -Wl,-rpath-link=
  libs =
  frameworks =
  swiftmodules =
  output_extension =
  output_dir = .
