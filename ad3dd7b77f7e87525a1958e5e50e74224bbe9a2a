        "startChar": 0,
        "endLine": 20,
        "endChar": 0
      },
      "fixSuggestions": [
        {
          "fixId": "4b698ca7_e0c1fb88",
          "description": "prompt_to_edit API",
          "replacements": [
            {
              "path": "src/gn/edit_subcommands.cc",
              "range": {
                "startLine": 1,
                "startChar": 0,
                "endLine": 1,
                "endChar": 0
              },
              "replacement": "  // If the value is explicitly wrapped in quotes, treat it as a string literal\n  // to bypass bool/int parsing.\n  if (val_string.size() \u003e\u003d 2 \u0026\u0026 val_string.starts_with(\u0027\"\u0027) \u0026\u0026\n      val_string.ends_with(\u0027\"\u0027)) {\n    return Value(nullptr, std::string(val_string.substr(1, val_string.size() - 2)));\n  }\n\n"
            }
          ]
        }
      ],
